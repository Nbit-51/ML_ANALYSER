{
  "adapter": "generic_process",
  "profile": "test_suite",
  "command": [
    "/usr/bin/python3",
    "-I",
    "harness.py"
  ],
  "config_file": "config.json",
  "candidate_overrides": {
    "repeats": 10
  },
  "metric_definitions": [
    {
      "name": "work_units",
      "unit": "operations",
      "direction": "minimize"
    },
    {
      "name": "checks_passed",
      "unit": "ratio",
      "minimum": 0,
      "maximum": 1
    },
    {
      "name": "elapsed_ms",
      "unit": "ms",
      "direction": "minimize"
    },
    {
      "name": "process_duration_ms",
      "unit": "ms",
      "direction": "minimize"
    }
  ],
  "warmup_count": 1,
  "repetitions": 5,
  "allowed_output_paths": [],
  "build_command": [
    "/usr/bin/python3",
    "-I",
    "build.py"
  ],
  "test_command": [
    "/usr/bin/python3",
    "-I",
    "tests.py"
  ]
}
