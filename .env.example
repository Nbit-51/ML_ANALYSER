# Application
ML_ANALYSER_APP_NAME=ML Analyser API
ML_ANALYSER_ENVIRONMENT=development
ML_ANALYSER_LOG_LEVEL=INFO
ML_ANALYSER_WORKSPACE_ROOT=workspaces
ML_ANALYSER_STATE_DATABASE=artifacts/ml_analyser.db
ML_ANALYSER_EXECUTION_ROOT=artifacts/executions

# Nebius Token Factory (leave values blank until access is provisioned)
# Set ML_ANALYSER_MODEL_PROVIDER=nebius only after all three values are ready.
ML_ANALYSER_MODEL_PROVIDER=mock
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Select a currently available NVIDIA Nemotron model from the Token Factory model list.
NEBIUS_MODEL=
# Use json_object only if the selected model does not support json_schema.
ML_ANALYSER_NEBIUS_RESPONSE_FORMAT=json_schema

# Optional GitHub sign-in. Blank credentials keep local demo mode available.
# Create an OAuth app with callback http://127.0.0.1:8000/api/v1/auth/callback.
ML_ANALYSER_APP_URL=http://127.0.0.1:8000
ML_ANALYSER_GITHUB_CLIENT_ID=
ML_ANALYSER_GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins allowed to use this trusted installation.
ML_ANALYSER_GITHUB_ALLOWED_USERS=
ML_ANALYSER_AUTH_DATABASE=artifacts/auth.db
